<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/boss_photo_title"
        android:textColor="@color/samu_pink"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/boss_preview_img"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/boss_photo_title" />

    <Button
        android:id="@+id/btn_boss_camera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/boss_photo_title"
        style="@style/SamuButton" />

    <Button
        android:id="@+id/btn_boss_gallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/icon_pick_gallery"
        style="@style/SamuButton" />

    <Button
        android:id="@+id/btn_boss_remove"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/boss_photo_removed"
        style="@style/SamuButton" />
</LinearLayout>
