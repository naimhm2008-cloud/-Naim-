<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_settings"
            android:textColor="@color/samu_pink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/set_gemini_title" style="@style/SamuSectionTitle" />
        <EditText android:id="@+id/set_gemini_key" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/set_gemini_hint"
            android:inputType="textPassword" style="@style/SamuInput" />
        <Button android:id="@+id/btn_save_gemini" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/set_save" style="@style/SamuButton" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/set_special_title" style="@style/SamuSectionTitle" />
        <EditText android:id="@+id/set_special_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/set_special_hint"
            android:inputType="text" style="@style/SamuInput" />
        <Button android:id="@+id/btn_save_name" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/set_save" style="@style/SamuButton" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/set_boss_photo_title" style="@style/SamuSectionTitle" />
        <Button android:id="@+id/btn_boss_photo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/boss_photo_title"
            style="@style/SamuButton" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/set_emergency_title" style="@style/SamuSectionTitle" />
        <EditText android:id="@+id/set_emergency_1" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/set_emergency_hint_1"
            android:inputType="phone" style="@style/SamuInput" />
        <EditText android:id="@+id/set_emergency_2" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:hint="@string/set_emergency_hint_2" android:inputType="phone"
            style="@style/SamuInput" />
        <Button android:id="@+id/btn_save_emergency" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/set_save" style="@style/SamuButton" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/set_voice_title" style="@style/SamuSectionTitle" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/set_voice_speed" android:textColor="@color/samu_text_dim" />
        <SeekBar android:id="@+id/set_voice_speed" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="100" android:progress="50" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/set_voice_pitch" android:textColor="@color/samu_text_dim" />
        <SeekBar android:id="@+id/set_voice_pitch" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="100" android:progress="65" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/set_applock_title" style="@style/SamuSectionTitle" />
        <Button android:id="@+id/btn_app_lock" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/app_lock_title"
            style="@style/SamuButton" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/set_backup_title" style="@style/SamuSectionTitle" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_backup" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_margin="3dp" android:text="@string/btn_backup" style="@style/SamuButton" />
            <Button android:id="@+id/btn_restore" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_margin="3dp" android:text="@string/btn_restore" style="@style/SamuButton" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/set_service_title" style="@style/SamuSectionTitle" />
        <Button android:id="@+id/btn_service_toggle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/btn_service_toggle"
            style="@style/SamuButton" />

        <TextView android:id="@+id/set_privacy_note" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="@string/privacy_note" android:textColor="@color/samu_text_dim"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
