<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/samu_pink"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <com.samu.ai.view.SamuAvatarView
        android:id="@+id/samu_avatar"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/home_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_active"
        android:textColor="@color/samu_text_dim"
        android:textSize="14sp"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/home_bubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_bubble_samu"
        android:padding="16dp"
        android:text="@string/home_welcome"
        android:textColor="@color/samu_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/home_greeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_button"
        android:padding="12dp 20dp"
        android:text="@string/nav_home"
        android:textColor="@android:color/white" />
</LinearLayout>
